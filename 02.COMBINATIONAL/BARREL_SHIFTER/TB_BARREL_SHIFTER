module tb_barrel_shifter;
  logic [7:0] data_in;
  logic [2:0] data_shift;
  logic direction;
  logic mode;
  logic [7:0] data_out;
  Barrel_shifter dut(.data_in(data_in),.data_shift(data_shift),.direction(direction),.mode(mode),.data_out(data_out));
  initial begin
    $monitor("Time = %0t | data_in=%b | data_shift=%d |direction=%b|mode = %b | data_out = %b",$time,data_in,data_shift,direction,mode,data_out);
    $dumpfile("dump.vcd");
    $dumpvars(1,tb_barrel_shifter);
    data_in = 11100111;
    direction = 1'b0;
    mode = 1'b0;
    data_shift = 2;
    #10;
    data_in = 11100001;
    direction = 1'b1;
    mode  = 1'b0;
    data_shift = 2;
    #10;
    data_in = 11100011;
    direction = 1'b0;
    mode = 1'b1;
    data_shift = 2;
    #10;
    data_in = 11100011;
    direction = 1'b1;
    mode = 1'b1;
    data_shift = 2;
    #10;
    $finish;
  end
endmodule
