module TB;
  logic Y0;
  logic Y1;
  logic Y2;
  logic Y3;
  logic S0;
  logic S1;
  logic Y;
  MUX4TO1 dut (.Y0(Y0),
               .Y1(Y1),
               .Y2(Y2),
               .Y3(Y3),
               .S0(S0),
               .S1(S1),
               .Y(Y));
  initial begin
    $dumpfile("dump.vcd");
    $dumpvars(1,TB);
    $monitor("Time=%0t,Y0=%b,Y1=%b,Y2=%b,Y3=%b,S0=%b,S1=%b,Y=%b",
             $time,
             Y0,
             Y1,
             Y2,
             Y3,
             S0,
             S1,
             Y);
    for(int i=0;i<16;i++) begin
      {Y3 ,Y2 ,Y1, Y0} = i;
      #10;
      for(int s=0;s<4;s++) begin
        {S1 ,S0} = s;
      #10;
      end
    end
  $finish;
  end
endmodule
    
